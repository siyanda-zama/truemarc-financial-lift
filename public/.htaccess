# Truemarc Consultants: Apache / LiteSpeed config for the prerendered site.
# The contents of dist/ go in the web root (public_html). Every page is a real file: /about → /about/index.html.

Options -Indexes -MultiViews
DirectoryIndex index.html index.php
# We serve /about from /about/index.html ourselves; without this Apache would 301 /about → /about/.
DirectorySlash Off
ErrorDocument 404 /404.html

AddDefaultCharset utf-8
AddCharset utf-8 .css .js .json .xml .txt .webmanifest
AddType application/manifest+json .webmanifest
AddType image/x-icon .ico
AddType image/svg+xml .svg
AddType image/webp .webp
AddType image/avif .avif
AddType font/woff2 .woff2

# ---------------------------------------------------------------------------
# Redirects and pretty URLs
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # www → apex. Uncomment once DNS for truemarc.co.za AND www.truemarc.co.za point here and the SSL
  # certificate covers both (cPanel → SSL/TLS Status). Goes first so www + http is a single hop.
  # RewriteCond %{HTTP_HOST} ^www\.truemarc\.co\.za$ [NC]
  # RewriteRule ^ https://truemarc.co.za%{REQUEST_URI} [R=301,L]

  # Any other domain parked on this hosting account → the main domain (uncomment if you park one).
  # RewriteCond %{HTTP_HOST} !^truemarc\.co\.za$ [NC]
  # RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  # RewriteRule ^ https://truemarc.co.za%{REQUEST_URI} [R=301,L]

  # HTTP → HTTPS. The X-Forwarded-Proto check prevents a redirect loop behind Cloudflare or a proxy.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Old site URLs. (/about, /services and /contact kept their addresses.)
  RewriteRule ^why-choose-us/?$ /about [R=301,L]

  # /index.html and /about/index.html → clean URL. THE_REQUEST = what the browser asked for, so the
  # internal rewrites below don't loop.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+(.+?)/index\.html[\s?] [NC]
  RewriteRule ^(.+?)/index\.html$ /$1 [R=301,L]

  # Trailing slash → none (canonical URLs have no trailing slash).
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteRule ^(.+?)/+$ /$1 [R=301,L]

  # /about → /about/index.html (prerendered page). Anything else that doesn't exist → 404.html.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# Never serve dotfiles (.git, .env, .gitignore…). .well-known/* stays reachable for SSL validation.
# ---------------------------------------------------------------------------
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------------
# Caching
#   js/css/woff2 only ever come from Vite's /assets/ with a content hash in the name → cache for a year.
#   (If you ever add an un-hashed .js file, e.g. a service worker, give it its own rule.)
#   Images/icons: a week (icons are cache-busted with ?v=, photos may be replaced in place).
#   HTML, sitemap, robots: always revalidate so a deploy shows up immediately.
#   PHP (api/) sets its own headers.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|gif|svg|ico|webmanifest)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  # HSTS: uncomment only after https://truemarc.co.za (and www, if used) work with a valid certificate.
  # Browsers then refuse plain HTTP for a year, so a broken certificate would take the site down.
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# ---------------------------------------------------------------------------
# Compression (LiteSpeed compresses on its own; Apache needs mod_deflate / mod_brotli)
# ---------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml image/x-icon
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml image/x-icon
</IfModule>
