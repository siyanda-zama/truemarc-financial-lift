# Lead API. Only lead.php and leads.php are public.
Options -Indexes

<IfModule mod_authz_core.c>
  # config.php (secrets), _lib.php, data/ (leads), and any stray database/log/backup files
  <FilesMatch "^(config(\.example)?\.php|_.*|.*\.(sqlite|sqlite-wal|sqlite-shm|jsonl|log|bak|json)|\..*)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^(config(\.example)?\.php|_.*|.*\.(sqlite|sqlite-wal|sqlite-shm|jsonl|log|bak|json)|\..*)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^data(/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Cache-Control "no-store"
</IfModule>
