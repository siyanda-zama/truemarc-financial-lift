#!/bin/sh
# Secret guard for repos deployed with the domains-cpanel-deploy kit.
# Enable once per clone:  git config core.hooksPath .githooks
#
# Why: real secrets were pasted into .env.example three times during the UbuntuSA build.
# .env.example is a template: every secret key must stay empty there. Real values live only in
# ~/<APP_DIR>/.env on the server, the local (ignored) .env, and GitHub repository secrets.

fail() { echo "pre-commit: $1" >&2; exit 1; }
staged=$(git diff --cached --name-only --diff-filter=ACMR)

# 1. Never commit a real .env (any folder), or the build output.
echo "$staged" | grep -qE '(^|/)\.env$' && fail "refusing to commit a .env file. Real values belong in .env (local, ignored) or the server's ~/<APP_DIR>/.env."
echo "$staged" | grep -qE '^deploy/' && fail "refusing to commit deploy/ (build output). Is /deploy/ in .gitignore? (Anchor it: '/deploy/', not 'deploy/'.)"

# 2. Templates must carry key names only. Public values (site keys, URLs, ports, names) are allowed.
#    A secret-named key with any value (bare, "quoted" or 'quoted') is refused; KEY=, KEY="" and KEY= # note are fine.
secret_lines() {
  grep -nE '^[[:space:]]*(export[[:space:]]+)?[A-Z0-9_]*(PASSWORD|PASSWD|SECRET|TOKEN|PRIVATE|API_KEY|MERCHANT_KEY|PASSPHRASE)[A-Z0-9_]*[[:space:]]*=[[:space:]]*("[^"]+"|'"'"'[^'"'"']+'"'"'|[^[:space:]#"'"'"'])' \
    | grep -vE '(SITE_KEY|PUBLIC)[A-Z0-9_]*[[:space:]]*=' | sed -E 's/=.*/=<value hidden>/'
}
for f in $(echo "$staged" | grep -E '(^|/)(\.env\.example|env\.example|\.env\.sample|\.env\.template)$'); do
  hits=$(git show ":$f" | secret_lines)
  if [ -n "$hits" ]; then
    echo "$hits" >&2
    fail "$f has a value for a secret key (lines above, values hidden). Empty it, move the real value to .env / the server .env / gh secret set, and rotate it if it was ever pushed."
  fi
done

# 3. Obvious private material anywhere in the staged diff.
if git diff --cached -U0 | grep -E '^\+' | grep -qE -- '-----BEGIN ([A-Z ]+ )?PRIVATE KEY-----'; then
  fail "a private key is staged. Remove it; keys go in a password manager or GitHub secrets."
fi
exit 0
