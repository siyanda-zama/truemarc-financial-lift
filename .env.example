# Server settings: ~/truemarc_app/.env on cp65.domains.co.za (create in cPanel File Manager, permissions 0600).
# KEY NAMES ONLY in this file. Real values live in that server file and nowhere in git.
# No comments after a value on the same line; put a value containing # in "double quotes".

# --- deploy kit (deploy-kit/README.md) ---
APP_ENV=
APP_URL=
DEPLOY_HOOK_TOKEN=

# --- lead endpoint + leads inbox (server/api/) ---
# Who gets the "new lead" email (comma separated). Default: admin@truemarc.co.za
LEAD_NOTIFY_TO=
# Sender mailbox (create it in cPanel > Email Accounts). Default: website@truemarc.co.za
MAIL_FROM=
MAIL_FROM_NAME=
# SMTP: host is the SERVER name (cp65.domains.co.za), port 465, ssl, username = the full mailbox address.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USERNAME=
SMTP_PASSWORD=
# Password hash for https://truemarc.co.za/api/leads.php (put it in 'single quotes': it contains $)
LEADS_ADMIN_PASSWORD_HASH=
# Random string used to hash visitor IPs for rate limiting (no raw IPs are stored)
LEADS_SECRET=
